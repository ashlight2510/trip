# cp .env.local.example .env.local
# 아래 값을 채운 뒤: npm run env:check

# ─── 1) 카카오 (장소 수집 + 로드뷰) ─────────────────────────
# https://developers.kakao.com/console/app
# 1. 내 애플리케이션 > 애플리케이션 추가하기
# 2. 앱 키에서 REST API 키 / JavaScript 키 복사
# 3. 플랫폼 > Web > 사이트 도메인: http://localhost:3000
# 4. (선택) 카카오맵 사용 시 관련 제품 활성화
KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_MAP_KEY=

# ─── 2) 네이버 (블로그 후기 검색, 장소당/지역당 최대 3개) ───
# 개발자센터 Search API 신규 신청은 2026-07-31 이후 차단 → NAVER API HUB 사용
# https://www.ncloud.com/product/applicationService/naverApiHub
# 1. NCP 콘솔 로그인 → NAVER API HUB → 서비스 이용 신청
# 2. Application 등록 → Search(검색) 선택
# 3. 인증 정보에서 Client ID / Client Secret 복사
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ─── 3) 유튜브 (영상 후기, 장소당 최대 1개 · 블로그와 믹스) ─
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
# 1. 프로젝트에서 YouTube Data API v3 사용 설정
# 2. 사용자 인증 정보 > API 키 만들기
# 3. (권장) API 제한: YouTube Data API v3 만 허용
YOUTUBE_DATA_API_KEY=

# ─── 4) 구글 (해외 로드뷰 / Places — 나중에) ───────────────
# https://console.cloud.google.com/apis/credentials
# 1. 프로젝트 생성
# 2. API 및 서비스 > 라이브러리에서 활성화:
#    - Maps JavaScript API (스트리트뷰)
#    - Places API (New) 또는 Places API
# 3. 사용자 인증 정보 > API 키 만들기
# 4. 키 제한: HTTP 리퍼러에 http://localhost:3000/*
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
