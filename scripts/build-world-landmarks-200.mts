function coordsFor(seed: Seed): [number, number] {
  if (COORDS[seed.name]) return COORDS[seed.name]!;
  const primary = seed.country.split("/")[0]!.trim();
  const fb = COUNTRY_FALLBACK[seed.country] ?? COUNTRY_FALLBACK[primary];
  if (!fb) {
    console.warn("Missing coords:", seed.name, seed.country);
    return [20, 0];
  }
  // Slight deterministic jitter so country-fallback pins don't stack perfectly.
  const h = [...seed.name].reduce((a, c) => a + c.charCodeAt(0), 0);
  return [fb[0] + ((h % 17) - 8) * 0.08, fb[1] + ((h % 23) - 11) * 0.08];
}

const ranked = WORLD_ATTRACTIONS_500.map((a, i) => ({
  ...a,
  score: fameScore(a.note) * 1000 + (WORLD_ATTRACTIONS_500.length - i),
}))
  .sort((a, b) => b.score - a.score)
  .slice(0, 200);

const landmarks = ranked.map((seed, i) => {
  const region = regionOf(seed.country);
  const [lat, lng] = coordsFor(seed);
  const over = OVERRIDES[seed.name];
  return {
    id: slugify(seed.name, i),
    name: seed.name,
    country: seed.country,
    region,
    lat: Math.round(lat * 10000) / 10000,
    lng: Math.round(lng * 10000) / 10000,
    headline: over?.headline ?? headlineFor(seed),
    summary: over?.summary ?? seed.intro,
    bestSeason: over?.bestSeason ?? seasonFor(seed.name, seed.country, region),
    experiences: over?.experiences ?? experiencesFor(seed),
    stories: over?.stories ?? storiesFor(seed),
    funFact: over?.funFact ?? funFactFor(seed),
    tone: imageTone(region),
    note: seed.note ?? "",
    image: `/landmarks/lm-${String(i + 1).padStart(3, "0")}.svg`,
    imageAlt: `${seed.name} 여행 일러스트 · ${seed.country}`,
  };
});

const outPath = path.resolve("src/lib/world-landmarks-200.ts");
const body = `/**
 * Top 200 world landmarks for map star-pins.
 * Generated by scripts/build-world-landmarks-200.mts — re-run to refresh.
 */
export type LandmarkRegion = "유럽" | "아시아" | "아메리카" | "아프리카" | "오세아니아" | "중동";

export type LandmarkCard = {
  name: string;
  description: string;
};

export type LandmarkStory = {
  name: string;
  dateHint: string;
  description: string;
};

export type WorldLandmark = {
  id: string;
  name: string;
  country: string;
  region: LandmarkRegion;
  lat: number;
  lng: number;
  headline: string;
  summary: string;
  bestSeason: string;
  experiences: LandmarkCard[];
  stories: LandmarkStory[];
  funFact: string;
  tone: string;
  note: string;
  /** Prefer AI painting (.jpg) when present; else unique SVG poster. */
  image: string;
  imageAlt: string;
};

export const WORLD_LANDMARKS_200: WorldLandmark[] = ${JSON.stringify(landmarks, null, 2)};
`;

fs.writeFileSync(outPath, body);
console.log(`Wrote ${landmarks.length} landmarks → ${outPath}`);
const missing = landmarks.filter((l) => !COORDS[l.name]);
console.log(`Fallback coords: ${missing.length}`);
if (missing.length) console.log(missing.slice(0, 30).map((m) => m.name).join(", "));
