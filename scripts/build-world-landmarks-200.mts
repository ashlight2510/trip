    },
  ];
}

function josa(word: string, pair: [string, string]): string {
  const last = word.replace(/[^가-힣a-zA-Z0-9]/g, "").slice(-1);
  if (!last) return pair[0];
  if (/[a-zA-Z0-9]/.test(last)) return pair[0];
  const code = last.charCodeAt(0) - 0xac00;
  if (code < 0 || code > 11171) return pair[0];
  return code % 28 === 0 ? pair[1] : pair[0];
}

function funFactFor(seed: Seed): string {
  const name = seed.name;
  const country = seed.country.split("/")[0]!;
  if ((seed.note ?? "").includes("신7대")) {
    return `${name}${josa(name, ["은", "는"])} ‘세계 신7대 불가사의’ 투표·선정 과정에서 전 세계인이 이름을 올린 상징 유적입니다.`;
  }
  if ((seed.note ?? "").includes("유네스코")) {
    return `유네스코 세계유산으로 보호받는 곳이라, 지정 탐방로와 사진 금지 구역을 지키는 것이 다음 세대를 위한 기본 매너입니다.`;
  }
  if ((seed.note ?? "").includes("Nat Geo")) {
    return `내셔널지오그래픽 등 세계적 여행·자연 매체가 자주 조명한 ‘포스터 풍경’으로, 같은 각도라도 날씨에 따라 전혀 다른 장면이 됩니다.`;
  }
  return `${country}${josa(country, ["을", "를"])} 대표하는 이미지로 SNS·영화·광고에 반복 등장해, 실제로 서 보면 스케일이 다르다는 감상이 많은 곳입니다.`;
}

function headlineFor(seed: Seed): string {
  const note = seed.note ?? "";
  if (note.includes("최고 방문권")) return "전 세계 여행자가 가장 많이 모이는 상징 스폿";
  if (note.includes("유네스코") && note.includes("Nat Geo")) return "세계유산이자 지구촌 포스터 풍경";
  if (note.includes("유네스코")) return "유네스코가 지켜온 인류의 풍경";
  if (note.includes("테마파크")) return "하루를 통째로 써도 모자란 꿈의 어트랙션";
  if (note.includes("휴양")) return "쉬러 왔다가 인생 컷을 남기게 되는 휴양 명소";
  return "한 번쯤 꼭 서 보고 싶은 세계적 명소";
}

function imageTone(region: string): string {
  const map: Record<string, string> = {
    유럽: "slate",
    아시아: "amber",
    아메리카: "sky",
    아프리카: "orange",
    오세아니아: "teal",
    중동: "rose",
  };
  return map[region] ?? "stone";
}

