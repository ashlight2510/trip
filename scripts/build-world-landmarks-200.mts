      description: "전관을 다 돌기보다 상징 공간 3–5곳을 깊게 보는 편이 피로도가 낮고 기억에 남습니다.",
    };
  }
  if (/국립공원|폭포|캐년|산|섬|해변|사파리|리프|사막/.test(n)) {
    base[1] = {
      name: "짧은 트레일·전망 포인트",
      description: "장거리 코스보다 전망이 좋은 짧은 루트와 안전 수칙(일출/날씨/야생)을 먼저 확인하세요.",
    };
  }
  if (/디즈니|유니버설/.test(n)) {
    return [
      { name: "앱·시간대 패스 활용", description: "인기 어트랙션은 오픈 직후·퍼레이드 시간대를 노리면 대기 시간이 크게 줄어듭니다." },
      { name: "퍼레이드·밤 쇼", description: "낮 놀이기구와 저녁 쇼를 하루 동선으로 묶으면 ‘테마파크다운’ 하루가 완성됩니다." },
      { name: "테마 구역별 맛집", description: "랜드/존마다 시그니처 스낵이 있으니 줄이 짧은 사이드 메뉴부터 공략해보세요." },
    ];
  }
  return base;
}

function storiesFor(seed: Seed): { name: string; dateHint: string; description: string }[] {
  const unesco = (seed.note ?? "").includes("유네스코");
  return [
    {
      name: unesco ? "세계유산으로 남은 이유" : "이 장소가 유명해진 배경",
      dateHint: unesco ? "유네스코" : "역사·문화",
      description: unesco
        ? `${seed.name}은(는) 인류 공동 유산으로 보호받는 곳으로, 방문 자체가 ‘보존된 풍경을 빌리는’ 경험에 가깝습니다.`
        : `${seed.intro} 여행자들은 그 상징성 때문에 세대를 이어 발길을 이어왔습니다.`,
    },
    {
      name: "여행자가 자주 하는 실수",
