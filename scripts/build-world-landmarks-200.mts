function regionOf(country: string): string {
  const primary = country.split("/")[0]!.trim();
  return REGION_BY_COUNTRY[primary] ?? REGION_BY_COUNTRY[country] ?? "유럽";
}

function fameScore(note?: string): number {
  const n = note ?? "";
  if (n.includes("최근 5년 최고 방문권")) return 100;
  if (n.includes("최근 5년")) return 90;
  if (n.includes("최근 방문 상위")) return 80;
  if (n.includes("테마파크 상위")) return 78;
  if (n.includes("휴양 상위")) return 72;
  if (n.includes("유네스코") && (n.includes("Nat Geo") || n.includes("신7대"))) return 88;
  if (n.includes("유네스코") && n.includes("최근")) return 85;
  if (n.includes("Nat Geo")) return 70;
  if (n.includes("유네스코")) return 60;
  if (n.includes("Travel + Leisure") || n.includes("Lonely Planet")) return 55;
  if (n.includes("미술관") || n.includes("도시 관광 상위")) return 50;
  return 30;
}

function slugify(name: string, i: number): string {
  return `lm-${String(i + 1).padStart(3, "0")}-${name
    .toLowerCase()
    .replace(/[^a-z0-9가-힣]+/gi, "-")
    .replace(/^-|-$/g, "")
    .slice(0, 40)}`;
}

function seasonFor(name: string, country: string, region: string): string {
  if (/디즈니|유니버설|몰|바자르|센소지|왕궁|박물관|미술관|궁전|대성당|모스크|타워|브리지/.test(name)) {
    return "사계절 · 성수기는 현지 방학·연휴";
  }
  if (/폭포|국립공원|사파리|세렝게티|마사이|크루거|오카방고|그레이트배리어|피요르드|알프스|로키|캐년|빙하|사막|트레킹|에베레스트|안나푸르나|한라|설악|후지/.test(name)) {
    if (region === "아프리카") return "건기(6–10월) 야생관찰이 특히 좋음";
    if (country.includes("호주") || country.includes("뉴질랜드")) return "현지 봄–가을(9–4월) 쾌적";
    if (region === "오세아니아") return "건기·건철이 방문 최적";
    return "늦봄–초가을, 혹한·우기 피하기";
  }
  if (/해변|비치|몰디브|보라보라|칸쿤|푸켓|발리|괌|와이키키|코파카바나|산토리니|이비사|카프리/.test(name)) {
    return "건기·따뜻한 달(지역별 우기 확인)";
  }
  if (/북극|아이슬란드|블루라군|오로라|레이캬비크/.test(name) || country.includes("아이슬란드")) {
    return "여름(백야)·겨울(오로라) 목적에 따라 선택";
  }
  if (region === "유럽") return "4–6월 · 9–10월 (여름 성수기 혼잡)";
  if (region === "아시아") return "가을–봄, 우기·폭염 구간 피하기";
  if (region === "중동") return "11–3월 선선한 계절";
  return "봄·가을이 무난, 현지 축제 일정 참고";
}

